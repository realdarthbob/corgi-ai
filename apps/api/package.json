{
  "name": "@corgi-ai/api",
  "version": "0.0.0",
  "private": true,
  "description": "Corgi AI backend: Fastify API and LangGraph agent",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "start": "tsx --env-file-if-exists=.env src/index.ts",
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@corgi-ai/shared": "*",
    "@langchain/anthropic": "^1.6.0",
    "@langchain/core": "^1.3.1",
    "@langchain/langgraph": "^1.5.3",
    "fastify": "^5.12.7",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@corgi-ai/config": "*",
    "@types/node": "^26.6.6",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "jiti": "^2.7.0",
    "typescript": "~6.0"
  }
}
